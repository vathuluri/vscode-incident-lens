{
  "name": "vscode-incident-lens",
  "displayName": "Incident Lens",
  "description": "AI-powered background code reviewer that flags patterns known to cause production incidents — powered by Claude.",
  "version": "0.1.0",
  "publisher": "vj",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/vathuluri/vscode-incident-lens"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Linters",
    "Other"
  ],
  "keywords": [
    "ai",
    "claude",
    "code review",
    "reliability",
    "incidents",
    "production"
  ],
  "activationEvents": [
    "onLanguage:typescript",
    "onLanguage:javascript",
    "onLanguage:python",
    "onLanguage:go",
    "onLanguage:java",
    "onLanguage:csharp"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "incidentLens.reviewFile",
        "title": "Incident Lens: Review Current File"
      },
      {
        "command": "incidentLens.clearDiagnostics",
        "title": "Incident Lens: Clear Diagnostics"
      }
    ],
    "configuration": {
      "title": "Incident Lens",
      "properties": {
        "incidentLens.apiKey": {
          "type": "string",
          "default": "",
          "description": "Anthropic API key. Leave empty to use ANTHROPIC_API_KEY environment variable.",
          "markdownDescription": "Anthropic API key. Leave empty to use `ANTHROPIC_API_KEY` environment variable."
        },
        "incidentLens.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable automatic review on file save."
        },
        "incidentLens.debounceMs": {
          "type": "number",
          "default": 2000,
          "description": "Milliseconds to wait after save before triggering review."
        },
        "incidentLens.maxFileLines": {
          "type": "number",
          "default": 500,
          "description": "Skip review for files larger than this line count."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0"
  }
}
